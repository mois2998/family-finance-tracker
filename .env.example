# ==============================================================================
# Family Finance Tracker - Environment Configuration
# ==============================================================================

# 1. DATABASE_URL (MySQL Connection String)
# ------------------------------------------------------------------------------
# Local MySQL:
# DATABASE_URL="mysql://root:root@localhost:3306/family_finance"
#
# External Cloud MySQL (e.g. TiDB Cloud, Aiven, Railway, AWS RDS, PlanetScale):
# Most external cloud databases require SSL and connection pooling limits for serverless:
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=strict&connection_limit=5&connect_timeout=30
#
# Note: If your password contains special characters (like @, #, $, %, etc.),
# make sure to URL-encode them (e.g., '@' becomes '%40', '#' becomes '%23').
DATABASE_URL="mysql://username:password@your-db-host.com:3306/family_finance?sslaccept=strict&connection_limit=5"

# 2. JWT_SECRET
# ------------------------------------------------------------------------------
# High-entropy random secret key used to sign session cookies and JWTs.
# Recommended: generate using `openssl rand -base64 32`
JWT_SECRET="family_finance_super_secret_jwt_key_at_least_32_characters_long"

# 3. NEXT_PUBLIC_APP_URL
# ------------------------------------------------------------------------------
# The public domain of your deployed application (used for invite links and redirects)
# On Vercel: https://your-project-name.vercel.app
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# 4. (Optional) External Database Sync for Migration
# ------------------------------------------------------------------------------
# Used by `npm run db:sync-external` to copy your local data to external MySQL
EXTERNAL_DATABASE_URL=""
